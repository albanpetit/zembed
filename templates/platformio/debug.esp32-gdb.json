// Debugging C/C++ (Arduino, ESP-IDF) firmware on an ESP32 with GDB + OpenOCD.
// Copy to `.zed/debug.json` at the root of your PlatformIO project.
//
// You need Espressif's GDB (14 or newer, with Python) and Espressif's OpenOCD.
// The ones PlatformIO installs may be too old or generic. The Arduino IDE's
// "esp32" board package ships both; adapt the version folders below to what
// you have in ~/.arduino15/packages/esp32/tools/ (Linux),
// ~/Library/Arduino15/packages/esp32/tools/ (macOS).
//
// The example targets an ESP32-S3 over its built-in USB-JTAG (the same USB
// cable as for uploading). For another chip, change the GDB binary and the
// OpenOCD board file (e.g. xtensa-esp32-elf-gdb, board/esp32c3-builtin.cfg).
[
  {
    "label": "ESP32-S3: upload and debug (GDB)",
    "adapter": "gdb-openocd",
    "request": "attach",
    // Uploads over serial before the session starts.
    "build": {
      "command": "pio",
      "args": ["run", "-t", "upload"]
    },
    "gdb": "~/.arduino15/packages/esp32/tools/xtensa-esp-elf-gdb/17.1_20260402/bin/xtensa-esp32s3-elf-gdb",
    "openocd": "~/.arduino15/packages/esp32/tools/openocd-esp32/v0.12.0-esp32-20260424/bin/openocd",
    "openocdArgs": ["-f", "board/esp32s3-builtin.cfg"]
    // Optional: the PlatformIO environment whose firmware is debugged.
    // "pioEnv": "seeed_xiao_esp32s3"
  },
  {
    "label": "ESP32-S3: attach (GDB)",
    "adapter": "gdb-openocd",
    "request": "attach",
    "gdb": "~/.arduino15/packages/esp32/tools/xtensa-esp-elf-gdb/17.1_20260402/bin/xtensa-esp32s3-elf-gdb",
    "openocd": "~/.arduino15/packages/esp32/tools/openocd-esp32/v0.12.0-esp32-20260424/bin/openocd",
    "openocdArgs": ["-f", "board/esp32s3-builtin.cfg"]
  }
]
