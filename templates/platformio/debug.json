// Debugging C/C++ (Arduino, ESP-IDF) firmware on an ESP32 with GDB + OpenOCD.
// Copy to `.zed/debug.json` at the root of your PlatformIO project.
//
// Nothing else to set for chips with built-in USB-JTAG (ESP32-S3, C3, C5, C6,
// H2, P4) plugged in over USB: Zembed reads the board from platformio.ini,
// finds GDB and OpenOCD (Arduino IDE, ESP-IDF or PlatformIO tools), checks
// that the board answers, and debugs .pio/build/<env>/firmware.elf.
// See the Zembed README for the optional keys.
[
  {
    "label": "Upload and debug",
    "adapter": "gdb-openocd",
    // Uploads over serial before the session starts.
    "build": { "command": "pio", "args": ["run", "-t", "upload"] }
  },
  {
    "label": "Attach to running firmware",
    "adapter": "gdb-openocd"
  }
]
